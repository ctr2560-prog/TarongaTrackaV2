# Firebase App Check (see the rollout notes in src/firebase.js before enabling)
#
# VITE_APPCHECK_SITE_KEY — the PUBLIC reCAPTCHA v3 site key from
#   Firebase Console → App Check → register web app.
#   Leave unset and App Check is inert: the app behaves exactly as before.
#   ⚠️ Must also be set in the GitHub Actions build env, or the deployed site
#      will ship without App Check even if it works locally.
# VITE_APPCHECK_SITE_KEY=

# VITE_APPCHECK_DEBUG — set to true for LOCAL DEV ONLY. Prints a debug token in the
#   browser console; register it under App Check → Manage debug tokens.
#   🚫 Never set this in a production build.
# VITE_APPCHECK_DEBUG=false
