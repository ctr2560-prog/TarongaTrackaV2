// ⚠️ THIS IS THE ONLY CANONICAL FIRESTORE RULES FILE for the shared
// "tarongatracka" project — used by both Taronga Tracka and Wildly by
// Taronga (/Users/cameronrodgers/wildly, separate repo, no local rules
// file of its own by design). Only ever deploy rules from THIS repo
// (`firebase deploy --only firestore:rules`, run from taronga-tracka-vite).
// If a firestore.rules file ever reappears in the Wildly repo, delete it —
// don't deploy it. See CLAUDE.md "Taronga Education ecosystem" section.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Schools leaderboard ───────────────────────────────────────────────────
    // Public read (leaderboard visible to all teachers).
    // Write allowed from client — points are incremented by student submissions
    // and class creation, both of which run in authenticated + unauthenticated
    // contexts, so we allow from any origin but only with valid data shape.
    // ⚠️ WRITE STAYS OPEN, deliberately. Students increment their school's points when they
    //    finish an activity (StudentContext) and they have no Firebase Auth at all, so this
    //    cannot be restricted to staff without routing every student submission through a Cloud
    //    Function. Teachers also write it on class creation.
    //    What protects it now is App Check: only the real app can reach this at all. The worst
    //    case is a leaderboard number, not student data.
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Classes ───────────────────────────────────────────────────────────────
    // Students find their class by code without logging in → public read.
    // Write is open so the staff portal (code-based login) can delete classes.
    // ⚠️ Students look up their class by code with no login, so `read` must stay open.
    //    The class DOCUMENT itself is only ever written by an authenticated teacher
    //    (CreateClassScreen, and the GPS toggle on ClassDetailsScreen) — verified by
    //    grepping every write path — so create/update/delete require Firebase Auth.
    match /classes/{classCode} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;

      // Student records.
      // ⚠️ `create` and `update` MUST stay open: students have no Firebase Auth at all, they
      //    join with a class code and an alias, and every mode writes progress as they go.
      //    This is the single biggest remaining hole in the system — anyone can read or alter
      //    any student record — and closing it properly means routing student writes through
      //    a Cloud Function. That is weeks of work, not a rules tweak. Do not pretend
      //    otherwise.
      //
      // 🚫 `delete` is now DENIED to unauthenticated clients (2026-10-02). It was open, which
      //    meant anyone could wipe every class and every student in the system — the one
      //    irreversible action available. Teachers delete students from Class Details and are
      //    authenticated, so they still can. The staff Control Room's "wipe all data" has no
      //    Firebase Auth and now goes through the `adminWipeAllData` Cloud Function instead.
      //    ⚠️ If a staff delete ever "stops working", fix the function — do NOT reopen this.
      match /students/{studentId} {
        allow read: if true;
        allow create: if true;

        // ⚠️ A student may only change THEIR OWN record (2026-10-03). Three arms, each needed:
        //
        //   1. `ownsStudentRecord()` — the anonymous device id stamped at join. This is the
        //      actual protection: before it, anyone could rewrite any student's scores.
        //   2. `unclaimedStudentRecord()` — BACK-COMPAT. Every record created before today has
        //      no `deviceUid`, and those classes must keep working. Protection applies to new
        //      classes; old ones age out. Also covers a record the teacher has released.
        //   3. `isEducator()` — teachers and staff. ⚠️ WITHOUT THIS, "Restore" and "New device"
        //      on Class Details both fail: a teacher's uid is not the student's deviceUid.
        //      It tests for an EMAIL on the token, because `request.auth != null` is true for
        //      anonymous students too and would grant everyone everything.
        //
        // ⚠️ `deviceUid in resource.data` is checked before reading it — reading a field that
        //    does not exist errors, and an erroring rule denies, which would lock out every
        //    pre-existing student.
        allow update: if unclaimedStudentRecord() || ownsStudentRecord() || isEducator();

        allow delete: if request.auth != null;
      }
    }

    function unclaimedStudentRecord() {
      return !('deviceUid' in resource.data) || resource.data.deviceUid == null;
    }

    function ownsStudentRecord() {
      return request.auth != null
        && 'deviceUid' in resource.data
        && request.auth.uid == resource.data.deviceUid;
    }

    // Anonymous students have NO email claim; teachers and staff sign in with email+password and
    // therefore do. That is what separates "an educator" from "any signed-in session".
    function isEducator() {
      return request.auth != null && request.auth.token.email != null;
    }

    // Collection-group read for `students`, so staff dashboards (e.g. Wildly's
    // Overview) can run an aggregate count across all classes. Additive and
    // read-only — direct-path read/write is already granted under classes above,
    // and writes are unaffected. Only enables the collectionGroup('students')
    // query; no new data is exposed beyond what the classes rule already allows.
    match /{path=**}/students/{studentId} {
      allow read: if true;
    }

    // ── Teacher data ─────────────────────────────────────────────────────────
    // Teacher profile document (email, commsOptIn, role, etc.)
    // `get` (single doc, known email) stays open — Tracka's own AppContext and
    // Wildly's per-teacher checks rely on reading one doc by a known/authenticated
    // email. `list` (the whole collection at once) is restricted to real
    // Firebase-authenticated staff via isWildlyStaff() (defined below) — it used
    // to be open too, which meant anyone with the Firestore SDK could enumerate
    // every teacher's email/school/role with zero login. The staff portal's own
    // "Users" tab is code-based (no Firebase Auth) and can no longer do this `list`
    // directly — it now goes through the server-verified `getAdminTeacherRoster`
    // Cloud Function instead (functions/index.js), which re-checks the admin
    // access code with the Admin SDK before returning the roster.
    // ⚠️ PRIVILEGE ESCALATION, FIXED 2026-10-03. `role` on this document is what isWildlyStaff()
    //    reads to decide who is Taronga staff — and users write their own document. Wildly's
    //    "About you" page offered "Education Staff", "Curriculum Leader" and "School Leader" in
    //    a self-select dropdown, so ANY teacher who signed up could promote themselves to staff
    //    and then list every teacher's email and school, edit Wildly's content, and delete other
    //    teachers' accounts.
    //    A user may still write their own profile, but may NOT give themselves a staff role, and
    //    may not change it once set. Existing staff (and the admin-code-gated setTeacherRole
    //    Cloud Function) are the only things that can grant one.
    // ⚠️ Client-side dropdown changes are NOT a fix for this. The rule is the control.
    match /teachers/{email} {
      allow get: if true;
      allow list: if isWildlyStaff();

      allow create: if request.auth != null && request.auth.token.email == email
                    && !grantsStaffRole(request.resource.data);
      allow update: if request.auth != null && request.auth.token.email == email
                    && (!grantsStaffRole(request.resource.data)
                        || roleOf(request.resource.data) == roleOf(resource.data));
      // Existing staff may set anyone's role, which is how a new staff member is appointed.
      allow write: if isWildlyStaff();
      // Wildly staff can remove a teacher account from the roster (staff console
      // Control Room). Deletes the profile doc only; the Firebase Auth login is
      // unaffected. Additive to the self-write rule above.
      allow delete: if isWildlyStaff();

      // Each teacher's class list subcollection
      match /classes/{classCode} {
        allow read, write: if request.auth != null && request.auth.token.email == email;
      }
    }

    // ── Access codes ─────────────────────────────────────────────────────────
    // ⚠️ STAFF ONLY (2026-10-03). The old comment claimed teachers read these to validate them —
    //    they do not. Every read and write of this collection is in AdminDashboardScreen; nothing
    //    teacher-facing or student-facing touches it. It was open because the staff portal had no
    //    Firebase Auth; now it does, so it can be closed properly.
    match /accessCodes/{codeId} {
      allow read, write: if isWildlyStaff();
    }

    // ── Admin access verification ─────────────────────────────────────────────
    // 🚫 CLOSED TO CLIENTS ENTIRELY (2026-10-02). The document ID IS the staff portal
    // access code, and this used to be `allow read: if true` so the login screen could
    // check it in the browser. That meant listing this collection returned the staff
    // password: a complete authentication bypass for the staff portal. Verified against
    // the live project — an unauthenticated script read it in 1.4 seconds.
    //
    // Verification now happens in the `verifyAdminCode` Cloud Function, which uses the
    // Admin SDK and therefore bypasses these rules. `getAdminTeacherRoster` does the same
    // check the same way. NOTHING in the client may read this collection.
    // ⚠️ Do not reopen `read` to "fix" an admin login problem — that is the vulnerability.
    match /adminAccess/{docId} {
      allow read, write: if false;
    }

    // Per-IP failed-login counters for the staff portal, written only by the Admin SDK
    // inside verifyAdminCode. Clients have no business reading or writing these: exposing
    // them would let an attacker clear their own lockout.
    match /adminAuthAttempts/{ip} {
      allow read, write: if false;
    }

    // ── Global app settings ───────────────────────────────────────────────────
    // ⚠️ READ MUST STAY OPEN. `settings/app` carries the global GPS flag and is read by every
    //    student via StudentContext, with no login. Close it and proximity unlocking breaks for
    //    every class at the zoo.
    // Write is staff only as of 2026-10-03 — the only writer is the Control Room GPS toggle,
    // which now runs behind a real staff account. Before this, anyone could flip GPS off for
    // every class in the system.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isWildlyStaff();
    }

    // ── Feedback ─────────────────────────────────────────────────────────────
    // Staff portal reads both collections unauthenticated (code-based login).
    // Students/teachers create freely; reads are open for the staff review tab.
    match /studentFeedback/{docId} {
      allow create: if true;
      allow read: if true;
    }

    match /teacherFeedback/{docId} {
      allow create: if request.auth != null;
      allow read: if true;
    }

    // ── Challenge submissions ─────────────────────────────────────────────────
    // Teachers create submissions (Firebase Auth required).
    // Staff portal reads and approves/rejects without Firebase Auth (code-based login).
    match /challengeSubmissions/{submissionId} {
      allow read, update: if true;
      allow create: if request.auth != null;
      allow delete: if false;   // 🚫 nothing deletes these
    }

    // ── ZooSnooz session documents ────────────────────────────────────────────
    // Wildest Dreams keepsake records — the film link a student keeps. Same shape and same
    // trust model as evolve_docs: students write them with no Firebase Auth, the souvenir link
    // reads them, and the unguessable token in the document is what actually gates access.
    // 🚫 delete denied — these are keepsakes, and the whole point is that they outlast the
    //    session. A retention job must run server-side with the Admin SDK.
    match /wildestDreams_docs/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // 🚫 delete denied (2026-10-02) — nothing deletes these, and they back the ZooSnooz NFC
    //    souvenir cards.
    match /zoosnooz_docs/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // ── ZooYard citizen science submissions ───────────────────────────────────
    // Students (no Firebase Auth) create submissions. Staff portal approves/denies
    // without Firebase Auth (code-based login). Teachers deny/delete their own
    // class's submissions — scoped client-side, same trust model as challengeSubmissions.
    // ⚠️ delete requires a login (2026-10-02). Teachers remove their own class's submissions
    //    from Class Details and are Firebase-authenticated; nothing else deletes these.
    match /citizenScienceSubmissions/{submissionId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }


    // ── Evolve (Stage 6) ──────────────────────────────────────────────────────
    // Advice written at the giraffe chapter, queued for staff moderation before any
    // younger student sees it. Students have no Firebase Auth, and the staff portal is
    // code-based, so both ends are open — same trust model as challengeSubmissions.
    // Documents carry a cohort year, never a student name.
    // 🚫 delete denied (2026-10-02) — nothing in the app deletes advice, and this is the
    //    moderation queue. Staff change `status`, which is an update, not a delete.
    match /evolveAdvice/{adviceId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // Per-student Evolve keepsake record (film URL + reflections), read by the souvenir
    // link the student keeps.
    // 🚫 delete denied (2026-10-02). Nothing in the app deletes these, and each one backs a
    //    PHYSICAL NFC souvenir tag already handed to a student — deleting the document bricks
    //    the tag permanently, with no way to reissue it.
    match /evolve_docs/{docId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // ── Device bookings ───────────────────────────────────────────────────────
    // Teachers view the calendar and create bookings (Firebase Auth required).
    // Staff portal manages bookings without Firebase Auth (code-based login).
    match /deviceBookings/{bookingId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if true;
    }

    // ── Resources ─────────────────────────────────────────────────────────────
    match /resources/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Pre/Post-visit Canva lesson links ─────────────────────────────────────
    // Teachers read these in the Resource Hub, so read stays open. Write is staff only as of
    // 2026-10-03 — the only writer is the staff portal's Pre/Post Lessons tab. Before this,
    // anyone could repoint a lesson link at any URL they liked, which would have been served to
    // teachers and classes as official Taronga content.
    match /prePostLinks/{docId} {
      allow read: if true;
      allow write: if isWildlyStaff();
    }

    // ── Wildly by Taronga ──────────────────────────────────────────────────────
    // Wildly shares this Firebase project (and the `teachers/{email}` identity above) rather
    // than having its own — see taronga-tracka-vite CLAUDE.md, "Taronga Education ecosystem".
    //
    // ⚠️ STAFF IS AN EXPLICIT EMAIL ALLOWLIST (2026-10-03). It used to be a `role` field on the
    //    user's own teacher document — a field THEY could write — which meant anyone who signed
    //    up could set role: "Education Staff" and become Taronga staff. An allowlist here cannot
    //    be escalated into: changing who is staff requires deploying this file, which requires
    //    access to the Firebase project itself.
    //
    // ⚠️ TO APPOINT A STAFF MEMBER: add their email below, lowercase, and run
    //    `firebase deploy --only firestore:rules` from THIS repo. That is deliberately slow and
    //    deliberately requires project access. Do NOT reintroduce a role-based check, an
    //    "appoint staff" screen, or a Cloud Function that grants this — an endpoint whose job is
    //    handing out privilege is the thing we just removed.
    //
    // ⚠️ `teachers/{email}.role` still exists as a PROFILE field and still drives some client-side
    //    UI in Wildly. It confers NO access. Never make it authoritative again.
    function isWildlyStaff() {
      return request.auth != null
        && (isRootAdmin() || exists(/databases/$(database)/documents/staffAdmins/$(request.auth.token.email)));
    }

    // ⚠️ ROOT ADMIN — hard-coded, and deliberately NOT removable from the app. Everything else
    //    about staff access can be changed from the Control Room; this cannot. It is the
    //    guarantee that a mistake, or a compromised staff account deleting the others, can never
    //    lock Taronga out of its own project. Changing it requires deploying this file.
    function isRootAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'thebiologybloke@gmail.com'
        ];
    }

    // ── Staff administrators ─────────────────────────────────────────────────
    // Document ID is the lowercased email. Presence in here IS staff access.
    //
    // ⚠️ ONLY EXISTING STAFF MAY WRITE THIS. That is the whole design. The privilege-escalation
    //    bug fixed on 2026-10-03 existed because staff status lived in `teachers/{email}.role` —
    //    a field on a document the SUBJECT could write — so anyone who signed up could promote
    //    themselves. Here the subject has no write access at all; only someone who is already an
    //    administrator can appoint another.
    //
    // ⚠️ A signed-in user may read ONLY THEIR OWN entry, so the staff login can tell them whether
    //    they have access without publishing the list of administrators to the world. Staff can
    //    read the whole list.
    // 🚫 Never grant `create` or `update` here to the account named by the document.
    // 🚫 Never make the root admin removable from the client — see isRootAdmin().
    match /staffAdmins/{email} {
      allow get: if request.auth != null && (request.auth.token.email == email || isWildlyStaff());
      allow list: if isWildlyStaff();
      allow write: if isWildlyStaff();
    }

    match /dashboardConfig/{docId} {
      allow read: if true;
      allow write: if isWildlyStaff();
    }

    match /contentItems/{docId} {
      allow read: if true;
      allow write: if isWildlyStaff();
    }

    // Per-content usage counters (views). Any signed-in teacher increments the
    // counter when they open a content item; the staff Analytics panel reads the
    // aggregates. Additive and low-risk — just counts, no personal data.
    match /contentStats/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /professionalLearning/{docId} {
      allow read: if true;
      allow write: if isWildlyStaff();
    }

    match /tarongaTvVideos/{docId} {
      allow read: if true;
      allow write: if isWildlyStaff();
    }

    match /upcomingEvents/{docId} {
      allow read: if true;
      allow write: if isWildlyStaff();
    }

    match /liveSessions/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /liveResponses/{docId} {
      allow read: if request.auth != null;
      allow create, update: if true;
      allow delete: if isWildlyStaff();
    }
  }
}
