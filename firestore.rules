// ⚠️ THIS IS THE ONLY CANONICAL FIRESTORE RULES FILE for the shared
// "tarongatracka" project — used by both Taronga Tracka and Wildly by
// Taronga (/Users/cameronrodgers/wildly, separate repo, no local rules
// file of its own by design). Only ever deploy rules from THIS repo
// (`firebase deploy --only firestore:rules`, run from taronga-tracka-vite).
// If a firestore.rules file ever reappears in the Wildly repo, delete it —
// don't deploy it. See CLAUDE.md "Taronga Education ecosystem" section.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Schools leaderboard ───────────────────────────────────────────────────
    // Public read (leaderboard visible to all teachers).
    // Write allowed from client — points are incremented by student submissions
    // and class creation, both of which run in authenticated + unauthenticated
    // contexts, so we allow from any origin but only with valid data shape.
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Classes ───────────────────────────────────────────────────────────────
    // Students find their class by code without logging in → public read.
    // Write is open so the staff portal (code-based login) can delete classes.
    match /classes/{classCode} {
      allow read: if true;
      allow write: if true;

      // Student records — students have no Firebase Auth; they write with a
      // class code + chosen alias.  Teachers and admins read all students.
      match /students/{studentId} {
        allow read, write: if true;
      }
    }

    // Collection-group read for `students`, so staff dashboards (e.g. Wildly's
    // Overview) can run an aggregate count across all classes. Additive and
    // read-only — direct-path read/write is already granted under classes above,
    // and writes are unaffected. Only enables the collectionGroup('students')
    // query; no new data is exposed beyond what the classes rule already allows.
    match /{path=**}/students/{studentId} {
      allow read: if true;
    }

    // ── Teacher data ─────────────────────────────────────────────────────────
    // Teacher profile document (email, commsOptIn, role, etc.)
    // `get` (single doc, known email) stays open — Tracka's own AppContext and
    // Wildly's per-teacher checks rely on reading one doc by a known/authenticated
    // email. `list` (the whole collection at once) is restricted to real
    // Firebase-authenticated staff via isWildlyStaff() (defined below) — it used
    // to be open too, which meant anyone with the Firestore SDK could enumerate
    // every teacher's email/school/role with zero login. The staff portal's own
    // "Users" tab is code-based (no Firebase Auth) and can no longer do this `list`
    // directly — it now goes through the server-verified `getAdminTeacherRoster`
    // Cloud Function instead (functions/index.js), which re-checks the admin
    // access code with the Admin SDK before returning the roster.
    match /teachers/{email} {
      allow get: if true;
      allow list: if isWildlyStaff();
      allow write: if request.auth != null && request.auth.token.email == email;
      // Wildly staff can remove a teacher account from the roster (staff console
      // Control Room). Deletes the profile doc only; the Firebase Auth login is
      // unaffected. Additive to the self-write rule above.
      allow delete: if isWildlyStaff();

      // Each teacher's class list subcollection
      match /classes/{classCode} {
        allow read, write: if request.auth != null && request.auth.token.email == email;
      }
    }

    // ── Access codes ─────────────────────────────────────────────────────────
    // Teachers read codes to validate them; admins create/update via code-based
    // login (no Firebase Auth), so writes must also be open.
    match /accessCodes/{codeId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Admin access verification ─────────────────────────────────────────────
    // The access code IS the credential — the login screen reads this collection
    // unauthenticated to verify the code. Security comes from the code being secret,
    // not from Firebase Auth (which isn't used for admin login).
    match /adminAccess/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Global app settings ───────────────────────────────────────────────────
    // Write is open so the staff portal (code-based login) can toggle GPS and other settings.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Feedback ─────────────────────────────────────────────────────────────
    // Staff portal reads both collections unauthenticated (code-based login).
    // Students/teachers create freely; reads are open for the staff review tab.
    match /studentFeedback/{docId} {
      allow create: if true;
      allow read: if true;
    }

    match /teacherFeedback/{docId} {
      allow create: if request.auth != null;
      allow read: if true;
    }

    // ── Challenge submissions ─────────────────────────────────────────────────
    // Teachers create submissions (Firebase Auth required).
    // Staff portal reads and approves/rejects without Firebase Auth (code-based login).
    match /challengeSubmissions/{submissionId} {
      allow read, update: if true;
      allow create: if request.auth != null;
    }

    // ── ZooSnooz session documents ────────────────────────────────────────────
    match /zoosnooz_docs/{docId} {
      allow read, write: if true;
    }

    // ── ZooYard citizen science submissions ───────────────────────────────────
    // Students (no Firebase Auth) create submissions. Staff portal approves/denies
    // without Firebase Auth (code-based login). Teachers deny/delete their own
    // class's submissions — scoped client-side, same trust model as challengeSubmissions.
    match /citizenScienceSubmissions/{submissionId} {
      allow read, write, delete: if true;
    }

    // ── Device bookings ───────────────────────────────────────────────────────
    // Teachers view the calendar and create bookings (Firebase Auth required).
    // Staff portal manages bookings without Firebase Auth (code-based login).
    match /deviceBookings/{bookingId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if true;
    }

    // ── Resources ─────────────────────────────────────────────────────────────
    match /resources/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Pre/Post-visit Canva lesson links ─────────────────────────────────────
    // Staff portal (code-based login, no Firebase Auth) manages these entries.
    // Teachers read them in the Resource Hub — public read, open write.
    match /prePostLinks/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // ── Wildly by Taronga ──────────────────────────────────────────────────────
    // Wildly shares this Firebase project (and the `teachers/{email}` identity
    // above) rather than having its own — see taronga-tracka-vite CLAUDE.md,
    // "Taronga Education ecosystem" section. isWildlyStaff() mirrors Wildly's
    // former standalone isStaff() check, just against the shared teacher doc.
    function isWildlyStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/teachers/$(request.auth.token.email))
        && get(/databases/$(database)/documents/teachers/$(request.auth.token.email)).data.role in [
          "Education Staff", "Curriculum Leader", "School Leader"
        ];
    }

    match /dashboardConfig/{docId} {
      allow read: if true;
      allow write: if isWildlyStaff();
    }

    match /contentItems/{docId} {
      allow read: if true;
      allow write: if isWildlyStaff();
    }

    // Per-content usage counters (views). Any signed-in teacher increments the
    // counter when they open a content item; the staff Analytics panel reads the
    // aggregates. Additive and low-risk — just counts, no personal data.
    match /contentStats/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /professionalLearning/{docId} {
      allow read: if true;
      allow write: if isWildlyStaff();
    }

    match /tarongaTvVideos/{docId} {
      allow read: if true;
      allow write: if isWildlyStaff();
    }

    match /upcomingEvents/{docId} {
      allow read: if true;
      allow write: if isWildlyStaff();
    }

    match /liveSessions/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    match /liveResponses/{docId} {
      allow read: if request.auth != null;
      allow create, update: if true;
      allow delete: if isWildlyStaff();
    }
  }
}
