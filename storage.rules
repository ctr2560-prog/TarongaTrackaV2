rules_version = '2';

// Firebase Storage rules for the shared `tarongatracka` project.
//
// These used to live ONLY in the Firebase Console, which meant nobody could review them and a
// new upload path could fail silently for weeks. Three did exactly that (ZooYard's Habitat
// Hero photos, ZooYard's attest photos, and Evolve's clips). Keeping them here means adding a
// folder is part of building the feature.
//
// ⚠️ This file is only honoured because firebase.json has a "storage" key pointing at it.
//    Remove that key and this file is silently ignored.
//
// ⚠️ This project is shared with Wildly by Taronga (separate repo, same Firebase project).
//    Wildly uploads resource PDFs to `resources/`, which relies on the catch-all below.
//
// Deploy with:  firebase deploy --only storage

// ⚠️ `get` vs `list` — DO NOT COLLAPSE THESE BACK TO `read` (changed 2026-10-02).
//    `read` means BOTH "download a known file" AND "list what is in this folder". Until
//    2026-10-02 every path granted both, so an unauthenticated script could walk the whole
//    bucket and download every student video and photo. Confirmed against the live project:
//    listAll() succeeded on all five student paths with no login, and the folders are named
//    by class code and student alias, so the results came back pre-sorted.
//    Neither Tracka nor Wildly ever calls listAll(), so denying `list` costs nothing and
//    removes mass harvesting. Playback, downloads and the stitchers are unaffected.
//    ⚠️ This is NOT a full fix. Files are still downloadable by anyone who knows the exact
//    name, which is security-by-unguessable-URL. The real fix is short-lived signed URLs.
//
service firebase.storage {
  match /b/{bucket}/o {

    // ── Student paths ────────────────────────────────────────────────────────
    // Students have no Firebase Auth at all — they join with a class code and a chosen
    // alias — so these must allow UNAUTHENTICATED writes. They are the only exception to
    // the signed-in-write default below. Security comes from the paths being unguessable,
    // the same trust model used throughout firestore.rules.

    // ZooSnooz: per-animal night clips and the stitched documentary.
    match /zoosnooz/{allPaths=**} {
      allow get: if true;      // download a known file
      allow list: if false;    // 🚫 no folder browsing
      allow write: if true;
    }

    // Evolve: per-chapter pieces to camera and the final stitched film.
    match /evolve/{allPaths=**} {
      allow get: if true;      // download a known file
      allow list: if false;    // 🚫 no folder browsing
      allow write: if true;
    }

    // Wildest Dreams: per-animal student clips and the final stitched film.
    match /wildestDreams/{allPaths=**} {
      allow get: if true;      // download a known file
      allow list: if false;    // 🚫 no folder browsing
      allow write: if true;
    }

    // ZooYard: self-attest habitat photos (the student's tree / shady spot / open space).
    match /zooyardHabitats/{allPaths=**} {
      allow get: if true;      // download a known file
      allow list: if false;    // 🚫 no folder browsing
      allow write: if true;
    }

    // ZooYard: Habitat Hero citizen science evidence photos.
    match /citizenScienceEvidence/{allPaths=**} {
      allow get: if true;      // download a known file
      allow list: if false;    // 🚫 no folder browsing
      allow write: if true;
    }

    // ── Default ──────────────────────────────────────────────────────────────
    // Kept EXACTLY as it was in the Console: public read, signed-in write. This is what
    // `challengeEvidence/` (teachers) and `resources/` (Wildly staff) rely on, plus any
    // future authenticated upload path in either repo. Do not tighten this without
    // checking the Wildly repo too.
    match /{allPaths=**} {
      allow get: if true;      // download a known file
      allow list: if false;    // 🚫 no folder browsing
      allow write: if request.auth != null;
    }
  }
}
